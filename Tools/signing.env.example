# Copy this file to Tools/signing.env and fill in your Apple Developer team ID.
# Tools/signing.env is git-ignored. You can also set the DEVELOPMENT_TEAM
# environment variable instead.
#
# Find your team ID in Xcode: Settings → Accounts → your Apple ID → team list,
# or in the provisioning profile at ~/Library/MobileDevice/Provisioning Profiles.
DEVELOPMENT_TEAM=YOUR_TEAM_ID
